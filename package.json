{
  "name": "cropcal",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "test": "node --test 'tests/*.test.js'",
    "test:worker": "vitest run --root proxy",
    "test:all": "pnpm test && pnpm test:worker",
    "db:test:up": "docker start cropcal-pg 2>/dev/null || docker run -d --name cropcal-pg -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=cropcal_test -p 127.0.0.1:54329:5432 postgres:17-alpine",
    "db:migrate": "node proxy/scripts/migrate.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.5.1",
    "vitest": "^5.1.0",
    "wrangler": "^4.131.1"
  },
  "dependencies": {
    "pg": "^8.23.1"
  }
}
